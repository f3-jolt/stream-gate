# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: set to a specific guild ID to deploy commands to that server only (instant, for dev).
# Leave blank to deploy commands globally (works in all servers, takes up to 1 hour).
GUILD_ID=

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_WEBHOOK_SECRET=

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_WEBSUB_SECRET=

# Server
PORT=3000
PUBLIC_URL=https://yourdomain.com   # Must be HTTPS for Twitch EventSub and YouTube WebSub

# Origin(s) of the separately-hosted web admin UI (e.g. Firebase Hosting).
# When set, the API sends CORS headers to these origins, the session cookie
# becomes cross-site capable (SameSite=None), and OAuth redirects return here.
# Comma-separate for multiple. Leave blank to keep the bundled /admin behaviour.
# WEB_ORIGIN=https://stream-gate-web.web.app
